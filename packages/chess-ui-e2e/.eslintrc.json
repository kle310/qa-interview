{
  "extends": ["plugin:playwright/recommended", "../../.eslintrc.json"],
  "ignorePatterns": [],

  "overrides": [
    {
      "files": ["*.ts", "*.tsx", "*.js", "*.jsx"],
      "rules": {}
    },
    {
      "files": ["*.ts", "*.tsx"],
      "rules": {}
    },
    {
      "files": ["*.js", "*.jsx"],
      "rules": {}
    },
    {
      "files": ["**/*.{ts,js,tsx,jsx}"],
      "rules": {
        "playwright/expect-expect": [
          "error",
          {
            "assertFunctionNames": [
              "assertMoveSucceeds",
              "assertMoveFails",
              "assertPawnPromotion",
              "expect"
            ]
          }
        ]
      }
    }
  ]
}
